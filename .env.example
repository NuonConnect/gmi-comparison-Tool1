# Copy to .env.local for local development (.env.local is gitignored).
# On Netlify, set the same keys under Site configuration → Environment variables.

# --- Zoho CRM (server-side only; NEVER prefix with VITE_) ---
# Lets advisors link a comparison to its Zoho enquiry. From a "Self Client" at
# https://api-console.zoho.com with scopes:
#   ZohoCRM.coql.READ,ZohoCRM.modules.deals.READ,ZohoCRM.modules.contacts.READ
# The refresh token acts as the Zoho user who generated it, so that user must
# be able to see the enquiries.
ZOHO_CLIENT_ID=1000.XXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxx.xxxxxxxx
# Optional — defaults are the zoho.com (US) data center.
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_URL=https://www.zohoapis.com

# The Zoho search checks the advisor's login with Netlify Identity. On Netlify
# the site's own Identity is used; locally, point this at the live site.
# IDENTITY_URL=https://<your-site>.netlify.app
# Only confirmed accounts on this email domain may search.
# STAFF_EMAIL_DOMAIN=nsib.ae
